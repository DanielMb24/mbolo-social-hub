# ==========================================
# Variables d'Environnement - Production
# ==========================================
# Copiez ce fichier et renommez-le .env.production
# Remplissez les valeurs avec vos propres credentials

# ==================== FRONTEND ====================
NODE_ENV=production
VITE_API_URL=https://mbolo-gateway.onrender.com
VITE_WS_URL=https://mbolo-gateway.onrender.com/ws-chat

# ==================== API GATEWAY ====================
GATEWAY_SPRING_PROFILES_ACTIVE=docker
GATEWAY_REDIS_HOST=your-redis-host.render.com
GATEWAY_REDIS_PORT=6379

# ==================== AUTH SERVICE ====================
AUTH_SPRING_PROFILES_ACTIVE=docker
AUTH_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_auth?retryWrites=true&w=majority
AUTH_REDIS_HOST=your-redis-host.render.com
AUTH_REDIS_PORT=6379

# Email Configuration (Gmail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://mbolo-auth.onrender.com/api/auth/google/callback
FRONTEND_URL=https://mbolo-frontend.onrender.com

# JWT Configuration
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-minimum-256-bits
JWT_EXPIRATION=86400000

# ==================== USER SERVICE ====================
USER_SPRING_PROFILES_ACTIVE=docker
USER_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_user?retryWrites=true&w=majority

# MinIO / S3 Configuration
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_PORT=443
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=mbolo-uploads
MINIO_USE_SSL=true

# ==================== CHAT SERVICE ====================
CHAT_SPRING_PROFILES_ACTIVE=docker
CHAT_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_chat?retryWrites=true&w=majority
CHAT_REDIS_HOST=your-redis-host.render.com
CHAT_REDIS_PORT=6379

# ==================== POST SERVICE ====================
POST_SPRING_PROFILES_ACTIVE=docker
POST_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_post?retryWrites=true&w=majority

# ==================== VIDEO SERVICE ====================
VIDEO_SPRING_PROFILES_ACTIVE=docker
VIDEO_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_video?retryWrites=true&w=majority
VIDEO_MINIO_ENDPOINT=https://your-minio-endpoint.com
VIDEO_MINIO_ACCESS_KEY=your-minio-access-key
VIDEO_MINIO_SECRET_KEY=your-minio-secret-key

# ==================== CLOUDINARY MEDIA STORAGE ====================
# Used by the Vercel serverless API for avatars, covers, posts, stories, chat media, and videos.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ==================== MODERATION SERVICE ====================
MODERATION_SPRING_PROFILES_ACTIVE=docker
MODERATION_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mbolo_moderation?retryWrites=true&w=majority

# ==================== MONITORING & LOGGING ====================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MBOLO=DEBUG

# ==================== NOTES ====================
# 1. Ne commitez JAMAIS ce fichier avec les vraies valeurs
# 2. Utilisez des secrets forts et uniques
# 3. Activez l'authentification 2FA sur tous les services
# 4. Changez les secrets régulièrement
# 5. Utilisez des variables d'environnement sur Render, pas ce fichier
