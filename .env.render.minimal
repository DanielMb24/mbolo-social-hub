# ==========================================
# Variables Essentielles - Render.com
# ==========================================
# Version minimale avec uniquement les variables à configurer manuellement
# Les autres sont gérées automatiquement par render.yaml

# ==================== SECRETS À CONFIGURER ====================

# JWT Secret (IMPORTANT: Utilisez le même pour gateway et auth)
JWT_SECRET=changez-ce-secret-par-un-secret-tres-long-et-securise-minimum-256-bits

# Email (Gmail)
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-app-password-gmail

# Google OAuth
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret

# MinIO / S3
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_ACCESS_KEY=votre-minio-access-key
MINIO_SECRET_KEY=votre-minio-secret-key

# MongoDB Atlas (6 bases de données)
MONGODB_AUTH_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_auth?retryWrites=true&w=majority
MONGODB_USER_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_user?retryWrites=true&w=majority
MONGODB_CHAT_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_chat?retryWrites=true&w=majority
MONGODB_POST_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_post?retryWrites=true&w=majority
MONGODB_VIDEO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_video?retryWrites=true&w=majority
MONGODB_MODERATION_URI=mongodb+srv://user:pass@cluster.mongodb.net/mbolo_moderation?retryWrites=true&w=majority

# ==================== NOTES ====================
# 1. Remplacez toutes les valeurs ci-dessus
# 2. Les URLs des services sont gérées automatiquement par render.yaml
# 3. Redis est géré automatiquement par Render
# 4. Pour MongoDB Atlas: autorisez l'IP 0.0.0.0/0
# 5. Pour Gmail: utilisez un "App Password"
# 6. Pour Google OAuth: ajoutez l'URL de callback
# 7. Le JWT_SECRET doit être le même partout
