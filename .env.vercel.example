# Vercel frontend environment variables
# Set these in Project Settings > Environment Variables.

# Leave these empty to use the same Vercel domain as the frontend.
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_ENV=production
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Serverless API variables
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mbolo
MONGODB_SERVICE_PREFIX=mbolo
# Optional overrides if database names change:
# MONGODB_AUTH_DB=mbolo_auth
# MONGODB_USER_DB=mbolo_user
# MONGODB_POST_DB=mbolo_post
# MONGODB_CHAT_DB=mbolo_chat
# MONGODB_VIDEO_DB=mbolo_video
# MONGODB_MODERATION_DB=mbolo_moderation
JWT_SECRET=replace_with_a_long_random_secret

# Media storage
# Use the single URL from Cloudinary Dashboard > API Keys.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or use the split variables instead:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
