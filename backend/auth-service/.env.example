# Configuration Email pour l'envoi d'OTP
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# Gmail (Recommandé pour le développement)
# 1. Allez sur https://myaccount.google.com/apppasswords
# 2. Créez un mot de passe d'application
# 3. Copiez-le ici (format: abcd efgh ijkl mnop)
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application

# Autres configurations possibles :

# Outlook/Hotmail
# MAIL_USERNAME=votre-email@outlook.com
# MAIL_PASSWORD=votre-mot-de-passe

# Yahoo
# MAIL_USERNAME=votre-email@yahoo.com
# MAIL_PASSWORD=votre-mot-de-passe

# SendGrid (Production recommandée)
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=votre-api-key-sendgrid

# Mailtrap (Tests uniquement)
# MAIL_USERNAME=votre-username-mailtrap
# MAIL_PASSWORD=votre-password-mailtrap
